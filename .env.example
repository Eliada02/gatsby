# Environment variables, all optional.
#
# Copy to .env.development or .env.production. Nothing here is required to run
# the site, build it, or pass CI — every variable has a documented fallback.
#
# Anything prefixed with GATSBY_ is inlined into the browser bundle and is
# therefore public. Never put a secret in one. The variables without that prefix
# are read at build time only, in Node, and never reach the client.

# --- Build-time only (Node) --------------------------------------------------

# Canonical origin, used for canonical URLs, Open Graph URLs, the sitemap and
# robots.txt. On Netlify, DEPLOY_PRIME_URL and URL are read automatically, so
# preview deploys emit their own URLs.
#
# Unset, the build falls back to http://localhost:8000, which the SEO layer
# treats as "no origin configured": absolute URLs are omitted rather than
# pointing a crawler at localhost. Supply this in production.
SITE_URL=

# --- Public (inlined into the browser bundle) --------------------------------

# Google Tag Manager container. Leaving it unset means no third-party script is
# loaded and no cookie is set; the dataLayer still receives every event, so the
# instrumentation is verifiable in the browser console in development.
#
# A container ID is public by nature — it appears in the page source of every
# site that uses one — so it is safe under the GATSBY_ prefix.
GATSBY_GTM_ID=

# Base URL for the resources API. Empty means same-origin, which is correct
# unless the API is hosted separately from the site.
GATSBY_API_BASE_URL=
