# Copy to .env.development or .env.production. Nothing here is required to run
# the site locally.

# Google Tag Manager container. Leaving it unset means no third-party script is
# loaded and no cookie is set; the dataLayer still receives every event, so the
# instrumentation is verifiable in the browser console in development.
GATSBY_GTM_ID=

# Canonical origin. On Netlify, DEPLOY_PRIME_URL and URL are read automatically,
# so preview deploys emit their own canonical and Open Graph URLs.
SITE_URL=

# Base URL for the resources API. Empty means same-origin, which is correct
# unless the API is hosted separately from the site.
GATSBY_API_BASE_URL=
